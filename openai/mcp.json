{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "shape": {
      "type": "streamable-http",
      "url": "https://shapefs.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "shape:mcp"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
